<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="18.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finora.controller.TransactionsController">
    <padding>
        <Insets bottom="40.0" left="32.0" right="32.0" top="16.0" />
    </padding>

    <VBox spacing="12.0" styleClass="filter-panel">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-toolbar">
            <Label fx:id="statusLabel" styleClass="table-status" text="Siap" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#openAddTransactionDialog" styleClass="primary-button" text="Tambah Transaksi" />
        </HBox>

        <FlowPane alignment="CENTER_LEFT" hgap="10.0" styleClass="filter-bar" vgap="10.0">
            <TextField fx:id="searchField" onAction="#applyFilters" prefWidth="160.0" promptText="Cari transaksi" />
            <ComboBox fx:id="typeFilter" onAction="#applyFilters" prefWidth="125.0" />
            <ComboBox fx:id="categoryFilter" onAction="#applyFilters" prefWidth="160.0" />
            <DatePicker fx:id="dateFrom" onAction="#applyFilters" prefWidth="125.0" promptText="Dari" />
            <DatePicker fx:id="dateTo" onAction="#applyFilters" prefWidth="125.0" promptText="Sampai" />
            <Button mnemonicParsing="false" onAction="#applyFilters" styleClass="filter-button" text="Cari" />
            <Button mnemonicParsing="false" onAction="#clearFilters" styleClass="secondary-button" text="Bersihkan" />
        </FlowPane>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-card">
        <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="center-table">
            <columns>
                <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Tanggal" />
                <TableColumn fx:id="descriptionColumn" prefWidth="220.0" text="Deskripsi" />
                <TableColumn fx:id="categoryColumn" prefWidth="150.0" text="Kategori" />
                <TableColumn fx:id="typeColumn" prefWidth="130.0" text="Tipe" />
                <TableColumn fx:id="amountColumn" prefWidth="150.0" text="Jumlah" />
                <TableColumn fx:id="actionsColumn" prefWidth="180.0" sortable="false" text="Aksi" />
            </columns>
        </TableView>
    </VBox>
</VBox>

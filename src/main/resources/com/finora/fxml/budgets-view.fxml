<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="18.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finora.controller.BudgetsController">
    <padding>
        <Insets bottom="40.0" left="32.0" right="32.0" top="16.0" />
    </padding>

    <VBox spacing="12.0" styleClass="filter-panel">
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-toolbar">
            <Label fx:id="statusLabel" styleClass="table-status" text="Siap" />
            <Region HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#openAddBudgetDialog" styleClass="primary-button" text="Tambah Anggaran" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
            <Label styleClass="form-label" text="Bulan" />
            <ComboBox fx:id="monthFilter" onAction="#applyFilters" prefWidth="140.0" />
            <Label styleClass="form-label" text="Tahun" />
            <ComboBox fx:id="yearFilter" onAction="#applyFilters" prefWidth="120.0" />
            <Button mnemonicParsing="false" onAction="#applyFilters" styleClass="filter-button" text="Terapkan" />
        </HBox>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-card">
        <TableView fx:id="budgetTable" VBox.vgrow="ALWAYS" styleClass="center-table">
            <columns>
                <TableColumn fx:id="categoryColumn" prefWidth="145.0" text="Kategori" />
                <TableColumn fx:id="periodColumn" prefWidth="95.0" text="Periode" />
                <TableColumn fx:id="amountColumn" prefWidth="130.0" text="Anggaran" />
                <TableColumn fx:id="spentColumn" prefWidth="130.0" text="Terpakai" />
                <TableColumn fx:id="remainingColumn" prefWidth="130.0" text="Sisa" />
                <TableColumn fx:id="progressColumn" prefWidth="170.0" text="Progres" />
                <TableColumn fx:id="actionsColumn" prefWidth="165.0" sortable="false" text="Aksi" />
            </columns>
        </TableView>
    </VBox>
</VBox>

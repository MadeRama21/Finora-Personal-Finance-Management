<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_LEFT" spacing="20.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.finora.controller.CategoriesController">
    <padding>
        <Insets bottom="40.0" left="32.0" right="32.0" top="16.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="page-toolbar">
        <Label fx:id="statusLabel" styleClass="table-status" text="Siap" />
        <Region HBox.hgrow="ALWAYS" />
        <Button mnemonicParsing="false" onAction="#openAddCategoryDialog" styleClass="primary-button" text="Tambah Kategori" />
    </HBox>

    <VBox VBox.vgrow="ALWAYS" styleClass="table-card">
        <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS" styleClass="center-table">
            <columns>
                <TableColumn fx:id="nameColumn" prefWidth="220.0" text="Nama" />
                <TableColumn fx:id="typeColumn" prefWidth="120.0" text="Tipe" />
                <TableColumn fx:id="iconColumn" prefWidth="140.0" text="Ikon" />
                <TableColumn fx:id="actionsColumn" prefWidth="180.0" sortable="false" text="Aksi" />
            </columns>
        </TableView>
    </VBox>
</VBox>
